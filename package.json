{
  "name": "receipt-recon-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "wait-on http://localhost:5000/api/health && cd frontend && npm run start",
    "dev:ai": "cd ai_service && python app/main.py",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:ai\" \"npm run dev:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:ai": "cd ai_service && python app/main.py",
    "prod": "concurrently \"npm run start:backend\" \"npm run start:ai\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "axios": "^1.15.0",
    "lodash": "^4.18.1"
  },
  "dependencies": {
    "cors": "^2.8.6"
  }
}
