# Backend Environment Variables (Production)
# Copy this to .env on your production server (e.g., Render)

# Database (Use your production MongoDB URI)
MONGO_URI=mongodb+srv://user:pass@production-cluster.mongodb.net/prodDB?retryWrites=true&w=majority

# Server
PORT=5001
NODE_ENV=production

# AI Service URL (Set to live service URL)
# Example: AI_SERVICE_URL=https://receipt-recon-ai.onrender.com
AI_SERVICE_URL=

# Frontend URL (Set to live frontend URL for CORS)
# Example: FRONTEND_URL=https://receipt-recon.vercel.app
FRONTEND_URL=
